<Window x:Class="LoomisBrowser.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ChromeBackgroundBrush}">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ===================== General ===================== -->
            <TextBlock Text="General" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Search engine" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox x:Name="SearchEngineCombo" Width="240" HorizontalAlignment="Left" Margin="0,0,0,6"
                      DisplayMemberPath="Name"/>
            <Button x:Name="ManageEnginesButton" Content="Manage search engines..." HorizontalAlignment="Left"
                    Padding="6,3" Margin="0,0,0,20" Click="ManageEnginesButton_Click"/>

            <!-- ===================== Appearance ===================== -->
            <TextBlock Text="Appearance" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <CheckBox x:Name="ShowBookmarkBarCheck" Content="Show Bookmark Bar" Margin="0,0,0,10"/>

            <TextBlock Text="Theme" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox x:Name="ThemeCombo" Width="180" HorizontalAlignment="Left" Margin="0,0,0,20">
                <ComboBoxItem Content="System"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>
            </ComboBox>

            <!-- ===================== Privacy & Security ===================== -->
            <TextBlock Text="Privacy &amp; Security" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Secure DNS" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
            <RadioButton x:Name="DnsOffOption" Content="Off — use system default DNS" GroupName="Dns" Margin="0,2"/>
            <RadioButton x:Name="DnsAutomaticOption" Content="Automatic — upgrade if current provider supports it" GroupName="Dns" Margin="0,2"/>
            <RadioButton x:Name="DnsCustomOption" Content="Custom — choose a provider:" GroupName="Dns" Margin="0,2"/>

            <ComboBox x:Name="DnsProviderCombo" Width="260" HorizontalAlignment="Left" Margin="24,4,0,4">
                <ComboBoxItem Content="Cloudflare (1.1.1.1)" Tag="cloudflare"/>
                <ComboBoxItem Content="Google" Tag="google"/>
                <ComboBoxItem Content="Quad9" Tag="quad9"/>
                <ComboBoxItem Content="CleanBrowsing" Tag="cleanbrowsing"/>
                <ComboBoxItem Content="Custom..." Tag="custom"/>
            </ComboBox>
            <TextBox x:Name="DnsCustomTemplateBox" Width="380" HorizontalAlignment="Left" Margin="24,0,0,4"
                      ToolTip="DoH template URL, e.g. https://dns.example.com/dns-query"/>
            <TextBlock Text="Changing Secure DNS requires restarting Loomis Browser to take effect."
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,0,0,20"
                       TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"/>

            <!-- ===================== Downloads ===================== -->
            <TextBlock Text="Downloads" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Location" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DownloadLocationBox" IsReadOnly="True" Padding="6,4"/>
                <Button Grid.Column="1" Content="Change..." Margin="6,0,0,0" Padding="10,4"
                        Click="ChangeDownloadLocationButton_Click"/>
            </Grid>

            <CheckBox x:Name="AskWhereToSaveCheck" Content="Ask where to save each file before downloading" Margin="0,2"/>
            <CheckBox x:Name="ShowDownloadsWhenDoneCheck" Content="Show downloads when they're done" Margin="0,2,0,20"/>

            <!-- ===================== About ===================== -->
            <TextBlock Text="About" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="AboutText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Button x:Name="CheckForUpdateButton" Content="Check for updates" HorizontalAlignment="Left"
                    Padding="8,4" Click="CheckForUpdateButton_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" Padding="14,5" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Content="Save" Padding="14,5" Click="SaveButton_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>

<Window x:Class="RemiBrowser.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RemiBrowser.Views"
        Title="Settings" Height="640" Width="760" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource ChromeBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Custom title bar (matches MainWindow) ===================== -->
        <Grid Grid.Row="0" Height="40" Background="{DynamicResource ChromeBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <TextBlock Text="⚙" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Settings" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                <Button Style="{StaticResource ChromeIconButton}" Width="40" Height="40"
                        Click="MinimizeButton_Click" Content="—" ToolTip="Minimize"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeIconButton}" Width="40" Height="40"
                        Click="MaximizeButton_Click" Content="▢" ToolTip="Maximize"/>
                <Button Style="{StaticResource CloseButton}" Width="40" Height="40"
                        Click="CancelButton_Click" Content="✕" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Left sidebar: search box + category nav ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="16" FontWeight="Bold"
                           Margin="16,16,16,10" Foreground="{DynamicResource TextPrimaryBrush}"/>

                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" CornerRadius="14"
                        Height="30" Margin="12,0,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="10,0,4,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="12"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="SidebarNav" DockPanel.Dock="Top" Margin="0,4,0,0">
                    <RadioButton x:Name="NavSearchEngine" GroupName="SettingsNav" Style="{StaticResource SettingsSidebarItem}"
                                 IsChecked="True" Checked="Nav_Checked" Content="Search engine"/>
                    <RadioButton x:Name="NavAppearance" GroupName="SettingsNav" Style="{StaticResource SettingsSidebarItem}"
                                 Checked="Nav_Checked" Content="Appearance"/>
                    <RadioButton x:Name="NavPrivacy" GroupName="SettingsNav" Style="{StaticResource SettingsSidebarItem}"
                                 Checked="Nav_Checked" Content="Privacy &amp; Security"/>
                    <RadioButton x:Name="NavAutofillPasswords" GroupName="SettingsNav" Style="{StaticResource SettingsSidebarItem}"
                                 Checked="Nav_Checked" Content="Autofill and passwords"/>
                    <RadioButton x:Name="NavDefaultBrowser" GroupName="SettingsNav" Style="{StaticResource SettingsSidebarItem}"
                                 Checked="Nav_Checked" Content="Default browser"/>
                    <RadioButton x:Name="NavOnStartup" GroupName="SettingsNav" Style="{StaticResource SettingsSidebarItem}"
                                 Checked="Nav_Checked" Content="On startup"/>
                    <RadioButton x:Name="NavDownloads" GroupName="SettingsNav" Style="{StaticResource SettingsSidebarItem}"
                                 Checked="Nav_Checked" Content="Downloads"/>
                    <RadioButton x:Name="NavCustomThemes" GroupName="SettingsNav" Style="{StaticResource SettingsSidebarItem}"
                                 Checked="Nav_Checked" Content="Custom Themes"/>
                    <RadioButton x:Name="NavAbout" GroupName="SettingsNav" Style="{StaticResource SettingsSidebarItem}"
                                 Checked="Nav_Checked" Content="About"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Right: category content (or flattened search results) ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" Padding="28,24,28,24" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentStack">

                    <!-- ===================== General ===================== -->
                    <StackPanel x:Name="PanelSearchEngine">
                        <TextBlock Text="Search engine" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Border Tag="search engine default google bing duckduckgo" Margin="0,0,0,10">
                            <StackPanel>
                                <ComboBox x:Name="SearchEngineCombo" Width="240" HorizontalAlignment="Left" Margin="0,0,0,6"
                                          DisplayMemberPath="Name"/>
                                <Button x:Name="ManageEnginesButton" Content="Manage search engines..." HorizontalAlignment="Left"
                                        Padding="6,3" Click="ManageEnginesButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== On startup ===================== -->
                    <StackPanel x:Name="PanelOnStartup" Visibility="Collapsed">
                        <TextBlock Text="On startup" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Border Tag="startup open new tab continue where left off specific pages homepage" Margin="0,0,0,10">
                            <StackPanel>
                                <RadioButton x:Name="StartupNewTabOption" GroupName="Startup" Margin="0,3"
                                             Content="Open the New Tab page" Checked="StartupOption_Checked"/>
                                <RadioButton x:Name="StartupContinueOption" GroupName="Startup" Margin="0,3"
                                             Content="Continue where you left off" Checked="StartupOption_Checked"/>
                                <RadioButton x:Name="StartupContinueAndNewTabOption" GroupName="Startup" Margin="0,3"
                                             Content="Continue where you left off and open a New Tab page" Checked="StartupOption_Checked"/>
                                <RadioButton x:Name="StartupSpecificPagesOption" GroupName="Startup" Margin="0,3"
                                             Content="Open a specific page or set of pages" Checked="StartupOption_Checked"/>

                                <!-- Only visible when StartupSpecificPagesOption is selected -->
                                <StackPanel x:Name="StartupPagesPanel" Margin="24,6,0,0" Visibility="Collapsed">
                                    <ListBox x:Name="StartupPagesList" Height="90" Width="360" HorizontalAlignment="Left"
                                             Margin="0,0,0,6"/>
                                    <Grid Width="360" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="StartupPageUrlBox" Padding="6,4"
                                                 KeyDown="StartupPageUrlBox_KeyDown"
                                                 ToolTip="Type a URL and press Enter or Add"/>
                                        <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Padding="10,4"
                                                Click="AddStartupPageButton_Click"/>
                                    </Grid>
                                    <Button x:Name="RemoveStartupPageButton" Content="Remove selected" HorizontalAlignment="Left"
                                            Margin="0,6,0,0" Padding="8,4" Click="RemoveStartupPageButton_Click"/>
                                    <Button x:Name="UseCurrentPagesButton" Content="Use current pages" HorizontalAlignment="Left"
                                            Margin="0,6,0,0" Padding="8,4" Click="UseCurrentPagesButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Default browser ===================== -->
                    <StackPanel x:Name="PanelDefaultBrowser" Visibility="Collapsed">
                        <TextBlock Text="Default browser" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Border Tag="default browser make remi windows" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="DefaultBrowserStatusText" TextWrapping="Wrap" MaxWidth="420"
                                           Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Button x:Name="MakeDefaultButton" Content="Make Remi the default browser" HorizontalAlignment="Left"
                                        Padding="8,4" Click="MakeDefaultButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Appearance ===================== -->
                    <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                        <TextBlock Text="Appearance" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Border Tag="bookmark bar show toolbar" Margin="0,0,0,10">
                            <CheckBox x:Name="ShowBookmarkBarCheck" Content="Show Bookmark Bar"/>
                        </Border>

                        <Border Tag="theme dark light system appearance color" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Theme" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="ThemeCombo" Width="180" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="System"/>
                                    <ComboBoxItem Content="Light"/>
                                    <ComboBoxItem Content="Dark"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Privacy & Security ===================== -->
                    <StackPanel x:Name="PanelPrivacy" Visibility="Collapsed">
                        <TextBlock Text="Privacy &amp; Security" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Border Tag="secure dns doh cloudflare google quad9 cleanbrowsing privacy security" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Secure DNS" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <RadioButton x:Name="DnsOffOption" Content="Off — use system default DNS" GroupName="Dns" Margin="0,2"/>
                                <RadioButton x:Name="DnsAutomaticOption" Content="Automatic — upgrade if current provider supports it" GroupName="Dns" Margin="0,2"/>
                                <RadioButton x:Name="DnsCustomOption" Content="Custom — choose a provider:" GroupName="Dns" Margin="0,2"/>

                                <ComboBox x:Name="DnsProviderCombo" Width="260" HorizontalAlignment="Left" Margin="24,4,0,4">
                                    <ComboBoxItem Content="Cloudflare (1.1.1.1)" Tag="cloudflare"/>
                                    <ComboBoxItem Content="Google" Tag="google"/>
                                    <ComboBoxItem Content="Quad9" Tag="quad9"/>
                                    <ComboBoxItem Content="CleanBrowsing" Tag="cleanbrowsing"/>
                                    <ComboBoxItem Content="Custom..." Tag="custom"/>
                                </ComboBox>
                                <TextBox x:Name="DnsCustomTemplateBox" Width="380" HorizontalAlignment="Left" Margin="24,0,0,4"
                                          ToolTip="DoH template URL, e.g. https://dns.example.com/dns-query"/>
                                <TextBlock Text="Changing Secure DNS requires restarting Remi Browser to take effect."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,0"
                                           TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- ===================== Delete browsing data ===================== -->
                        <Border Tag="delete browsing data history cookies cache clear" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Delete browsing data" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Delete history, cookies, cache, and more" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Button x:Name="DeleteBrowsingDataButton" Content="Delete browsing data..." HorizontalAlignment="Left"
                                        Padding="8,4" Click="DeleteBrowsingDataButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- ===================== Clear on close ===================== -->
                        <Border Tag="clear browsing data when closing remi exit automatically" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Clear browsing data when closing Remi" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <CheckBox x:Name="ClearOnCloseCheck" Content="Choose what to automatically delete every time you close Remi"
                                          Margin="0,2" Checked="ClearOnCloseCheck_CheckedChanged" Unchecked="ClearOnCloseCheck_CheckedChanged"/>

                                <StackPanel x:Name="ClearOnClosePanel" Margin="24,6,0,0" Visibility="Collapsed">
                                    <CheckBox x:Name="ClearOnCloseHistoryCheck" Content="Browsing history" Margin="0,2"/>
                                    <CheckBox x:Name="ClearOnCloseCookiesCheck" Content="Cookies and other site data" Margin="0,2"/>
                                    <CheckBox x:Name="ClearOnCloseCacheCheck" Content="Cached images and files" Margin="0,2"/>
                                    <CheckBox x:Name="ClearOnCloseDownloadHistoryCheck" Content="Download history" Margin="0,2"/>
                                    <CheckBox x:Name="ClearOnCloseAutofillCheck" Content="Autofill form data" Margin="0,2"/>
                                    <CheckBox x:Name="ClearOnClosePasswordsCheck" Content="Passwords" Margin="0,2"/>
                                    <TextBlock Text="Signing into sites again every time you reopen Remi is expected if 'Cookies and other site data' stays checked here."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                               TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Autofill and passwords ===================== -->
                    <StackPanel x:Name="PanelAutofillPasswords" Visibility="Collapsed">
                        <TextBlock Text="Autofill and passwords" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Border Tag="password manager passwords autofill save fill forms" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox x:Name="OfferSavePasswordsCheck" Content="Offer to save passwords" Margin="0,2"/>
                                <CheckBox x:Name="AutofillEnabledCheck" Content="Save and fill addresses, payment methods, and other info" Margin="0,2"/>
                                <Button x:Name="OpenPasswordManagerButton" Content="Open Password Manager..."
                                        HorizontalAlignment="Left" Padding="10,5" Margin="0,10,0,0"
                                        Click="OpenPasswordManagerButton_Click"/>
                                <TextBlock Text="Passwords are stored in the browser engine's built-in password store, encrypted per Windows account. The button above opens the engine's own Password Manager page to view, search, or remove saved logins."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Downloads ===================== -->
                    <StackPanel x:Name="PanelDownloads" Visibility="Collapsed">
                        <TextBlock Text="Downloads" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Border Tag="download location folder save" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Location" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DownloadLocationBox" IsReadOnly="True" Padding="6,4"/>
                                    <Button Grid.Column="1" Content="Change..." Margin="6,0,0,0" Padding="10,4"
                                            Click="ChangeDownloadLocationButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Tag="ask where save each file download" Margin="0,0,0,6">
                            <CheckBox x:Name="AskWhereToSaveCheck" Content="Ask where to save each file before downloading"/>
                        </Border>
                        <Border Tag="show downloads when done finished">
                            <CheckBox x:Name="ShowDownloadsWhenDoneCheck" Content="Show downloads when they're done"/>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Custom Themes ===================== -->
                    <StackPanel x:Name="PanelCustomThemes" Visibility="Collapsed">
                        <TextBlock Text="Custom Themes" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Border Tag="gradient custom theme color background canvas" Margin="0,0,0,14">
                            <CheckBox x:Name="CustomThemeEnabledCheck" Content="Use a custom gradient for the toolbar and tab strip"/>
                        </Border>

                        <Border Tag="gradient custom theme color background canvas stops drag">
                            <StackPanel>
                                <TextBlock Text="Drag to position up to 3 color stops. Click a stop to change its color."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <views:GradientCanvasControl x:Name="GradientCanvas"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== About ===================== -->
                    <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                        <TextBlock Text="About" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Border Tag="about version engine update">
                            <StackPanel>
                                <TextBlock x:Name="AboutText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button x:Name="CheckForUpdateButton" Content="Check for updates" HorizontalAlignment="Left"
                                        Padding="8,4" Click="CheckForUpdateButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource ChromeBackgroundBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12">
                    <Button Content="Cancel" Padding="14,5" Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <Button Content="Save" Padding="14,5" Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>

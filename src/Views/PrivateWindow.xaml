<Window x:Class="RemiBrowser.Views.PrivateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private Browsing — Remi Browser"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#1B1B1F"
        Closed="PrivateWindow_Closed">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: dark theme signals "private" the way every browser does -->
        <Grid Grid.Row="0" Height="44" Background="#1B1B1F" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                <Path Width="18" Height="18" Stretch="Uniform" Margin="4,0,8,0"
                      Fill="Transparent" Stroke="White" StrokeThickness="1.5"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M21,17.5C21,19.433 19.433,21 17.5,21C15.567,21 14,19.433 14,17.5C14,15.567 15.567,14 17.5,14C19.433,14 21,15.567 21,17.5Z M2,11H14M22,11H18 M4,11L4.6138,8.54479C5.15947,6.36211 5.43231,5.27077 6.24609,4.63538C7.0057,4.0423 8.03639,4.00282 10,4.00019M20,11L19.3862,8.54479C18.8405,6.36211 18.5677,5.27077 17.7539,4.63538C16.9943,4.0423 15.9636,4.00282 14,4.00019 M10,17.5C10,19.433 8.433,21 6.5,21C4.567,21 3,19.433 3,17.5C3,15.567 4.567,14 6.5,14C8.433,14 10,15.567 10,17.5Z M10,17.4999L10.6584,17.1707C11.5029,16.7484 12.4971,16.7484 13.3416,17.1707L14,17.4999"/>
                <Button x:Name="BackButton" Width="32" Height="32" Background="Transparent"
                        BorderThickness="0" Click="BackButton_Click">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="White"
                          StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M15,19L9,12L10.5,10.25M15,5L13,7.33333"/>
                </Button>
                <Button x:Name="ForwardButton" Width="32" Height="32" Background="Transparent"
                        BorderThickness="0" Click="ForwardButton_Click">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="White"
                          StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M9,5L11,7.33333M9,19L15,12L13.5,10.25"/>
                </Button>
                <Button x:Name="ReloadButton" Width="32" Height="32" Background="Transparent"
                        BorderThickness="0" Click="ReloadButton_Click">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="White" Stroke="{x:Null}"
                          Data="M3.67981,11.3333H2.92981H3.67981ZM3.67981,13L3.15157,13.5324C3.44398,13.8225 3.91565,13.8225 4.20805,13.5324L3.67981,13ZM5.88787,11.8657C6.18191,11.574 6.18377,11.0991 5.89203,10.8051C5.60029,10.511 5.12542,10.5092 4.83138,10.8009L5.88787,11.8657ZM2.52824,10.8009C2.2342,10.5092 1.75933,10.511 1.46759,10.8051C1.17585,11.0991 1.17772,11.574 1.47176,11.8657L2.52824,10.8009ZM18.6156,7.39279C18.8325,7.74565 19.2944,7.85585 19.6473,7.63892C20.0001,7.42199 20.1103,6.96007 19.8934,6.60721L18.6156,7.39279ZM16.8931,3.60787C16.5403,3.39077 16.0784,3.50074 15.8613,3.8535C15.6442,4.20626 15.7541,4.66822 16.1069,4.88532L16.8931,3.60787ZM12.4633,3.75939C12.877,3.77966 13.2288,3.46071 13.2491,3.047C13.2694,2.63328 12.9504,2.28146 12.5367,2.26119L12.4633,3.75939ZM12.0789,2.25C7.03155,2.25 2.92981,6.3112 2.92981,11.3333H4.42981C4.42981,7.15072 7.84884,3.75 12.0789,3.75V2.25ZM2.92981,11.3333L2.92981,13H4.42981L4.42981,11.3333H2.92981ZM4.20805,13.5324L5.88787,11.8657L4.83138,10.8009L3.15157,12.4676L4.20805,13.5324ZM4.20805,12.4676L2.52824,10.8009L1.47176,11.8657L3.15157,13.5324L4.20805,12.4676ZM19.8934,6.60721C19.1441,5.38846 18.1143,4.35941 16.8931,3.60787L16.1069,4.88532C17.1287,5.51419 17.9899,6.37506 18.6156,7.39279L19.8934,6.60721ZM12.5367,2.26119C12.385,2.25376 12.2323,2.25 12.0789,2.25V3.75C12.2078,3.75 12.336,3.75316 12.4633,3.75939L12.5367,2.26119Z M11.8825,21V21.75V21ZM20.3137,12.6667H21.0637H20.3137ZM20.3137,11L20.8409,10.4666C20.5487,10.1778 20.0786,10.1778 19.7864,10.4666L20.3137,11ZM18.1002,12.1333C17.8056,12.4244 17.8028,12.8993 18.094,13.1939C18.3852,13.4885 18.86,13.4913 19.1546,13.2001L18.1002,12.1333ZM21.4727,13.2001C21.7673,13.4913 22.2421,13.4885 22.5333,13.1939C22.8245,12.8993 22.8217,12.4244 22.5271,12.1332L21.4727,13.2001ZM5.31769,16.6061C5.10016,16.2536 4.63806,16.1442 4.28557,16.3618C3.93307,16.5793 3.82366,17.0414 4.0412,17.3939L5.31769,16.6061ZM11.5331,20.2423C11.1193,20.224 10.769,20.5447 10.7507,20.9585C10.7325,21.3723 11.0531,21.7226 11.4669,21.7408L11.5331,20.2423ZM7.11292,20.4296C7.4677,20.6433 7.92861,20.529 8.14239,20.1742C8.35617,19.8195 8.24186,19.3586 7.88708,19.1448L7.11292,20.4296ZM11.8825,21.75C16.9448,21.75 21.0637,17.6915 21.0637,12.6667H19.5637C19.5637,16.8466 16.133,20.25 11.8825,20.25V21.75ZM21.0637,12.6667V11H19.5637V12.6667H21.0637ZM19.7864,10.4666L18.1002,12.1333L19.1546,13.2001L20.8409,11.5334L19.7864,10.4666ZM19.7864,11.5334L21.4727,13.2001L22.5271,12.1332L20.8409,10.4666L19.7864,11.5334ZM11.4669,21.7408C11.6047,21.7469 11.7433,21.75 11.8825,21.75V20.25C11.7653,20.25 11.6488,20.2474 11.5331,20.2423L11.4669,21.7408ZM4.0412,17.3939C4.80569,18.6327 5.86106,19.6752 7.11292,20.4296L7.88708,19.1448C6.83872,18.5131 5.95602,17.6405 5.31769,16.6061L4.0412,17.3939Z"/>
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="16" Height="32" Margin="8,0" VerticalAlignment="Center">
                <TextBox x:Name="AddressBarTextBox" Background="Transparent" BorderThickness="0" Foreground="White"
                         VerticalContentAlignment="Center" Margin="12,0" KeyDown="AddressBarTextBox_KeyDown"/>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0">
                <Button Content="—" Width="32" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="White" Click="MinimizeButton_Click"/>
                <Button Content="▢" Width="32" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="White" Click="MaximizeButton_Click"/>
                <Button Content="✕" Width="32" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="White" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentHost" Grid.Row="1"/>
    </Grid>
</Window>

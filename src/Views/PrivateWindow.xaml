<Window x:Class="RemiBrowser.Views.PrivateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private Browsing — Remi Browser"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#1B1B1F"
        Closed="PrivateWindow_Closed">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: dark theme signals "private" the way every browser does -->
        <Grid Grid.Row="0" Height="44" Background="#1B1B1F" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                <TextBlock Text="🕶" FontSize="16" Margin="4,0,8,0" VerticalAlignment="Center"/>
                <Button x:Name="BackButton" Content="◀" Width="32" Height="32" Background="Transparent"
                        BorderThickness="0" Foreground="White" Click="BackButton_Click"/>
                <Button x:Name="ForwardButton" Content="▶" Width="32" Height="32" Background="Transparent"
                        BorderThickness="0" Foreground="White" Click="ForwardButton_Click"/>
                <Button x:Name="ReloadButton" Content="⟳" Width="32" Height="32" Background="Transparent"
                        BorderThickness="0" Foreground="White" Click="ReloadButton_Click"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="16" Height="32" Margin="8,0" VerticalAlignment="Center">
                <TextBox x:Name="AddressBarTextBox" Background="Transparent" BorderThickness="0" Foreground="White"
                         VerticalContentAlignment="Center" Margin="12,0" KeyDown="AddressBarTextBox_KeyDown"/>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0">
                <Button Content="—" Width="32" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="White" Click="MinimizeButton_Click"/>
                <Button Content="▢" Width="32" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="White" Click="MaximizeButton_Click"/>
                <Button Content="✕" Width="32" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="White" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentHost" Grid.Row="1"/>
    </Grid>
</Window>

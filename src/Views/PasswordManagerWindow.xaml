<Window x:Class="RemiBrowser.Views.PasswordManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Manager"
        Height="720" Width="960"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource ChromeBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Custom title bar ===================== -->
        <Grid Grid.Row="0" Height="40" Background="{DynamicResource ChromeBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="🔑 Password Manager" FontSize="13" Margin="14,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                <Button Style="{StaticResource ChromeIconButton}" Click="MinimizeButton_Click" Content="—" ToolTip="Minimize"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeIconButton}" Click="MaximizeButton_Click" Content="▢" ToolTip="Maximize"/>
                <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click" Content="✕" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentHost" Grid.Row="1"/>
    </Grid>
</Window>

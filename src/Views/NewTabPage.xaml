<UserControl x:Class="RemiBrowser.Views.NewTabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.Background>
            <SolidColorBrush x:Name="BackgroundBrushHolder" Color="Transparent"/>
        </Grid.Background>

        <!-- Semi-transparent overlay so tiles stay legible over bright custom backgrounds -->
        <Border x:Name="OverlayBorder" Background="#000000" Opacity="0" IsHitTestVisible="False"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,60,0,60">
            <StackPanel HorizontalAlignment="Center" MaxWidth="900">

                <TextBlock Text="Remi Browser" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,28"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Pinned -->
                <StackPanel x:Name="PinnedSection" Margin="0,0,0,24">
                    <TextBlock Text="Pinned" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ItemsControl x:Name="PinnedGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Recently visited -->
                <StackPanel x:Name="RecentSection">
                    <TextBlock Text="Recently visited" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ItemsControl x:Name="RecentGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <TextBlock x:Name="EmptyStateText"
                           Text="Your pinned and recently visited sites will appear here."
                           HorizontalAlignment="Center" Margin="0,12,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="CustomizeButton" Content="🎨 Customize"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Padding="10,6"
                Background="{DynamicResource SurfaceAltBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderThickness="0" Cursor="Hand"
                Click="CustomizeButton_Click"/>
    </Grid>
</UserControl>

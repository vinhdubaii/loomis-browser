<UserControl x:Class="LoomisBrowser.Views.NewTabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.Background>
            <SolidColorBrush x:Name="BackgroundBrushHolder" Color="Transparent"/>
        </Grid.Background>

        <!-- Semi-transparent overlay so top sites stay legible over bright custom backgrounds -->
        <Border x:Name="OverlayBorder" Background="#000000" Opacity="0" IsHitTestVisible="False"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">

            <TextBlock Text="Loomis Browser" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,28"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <ItemsControl x:Name="TopSitesGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock x:Name="EmptyStateText"
                       Text="Your top sites will appear here as you browse."
                       HorizontalAlignment="Center" Margin="0,12,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="Collapsed"/>
        </StackPanel>

        <Button x:Name="CustomizeButton" Content="🎨 Customize"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Padding="10,6"
                Background="#E7E7EA" BorderThickness="0" Cursor="Hand"
                Click="CustomizeButton_Click"/>
    </Grid>
</UserControl>

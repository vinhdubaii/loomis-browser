<Window x:Class="RemiBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RemiBrowser.Views"
        Title="Remi Browser"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: unified title bar / toolbar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: tab strip (collapsed when 1 tab) -->
            <RowDefinition Height="Auto"/> <!-- Row 2: bookmark bar (toggle) -->
            <RowDefinition Height="*"/>    <!-- Row 3: content host -->
        </Grid.RowDefinitions>

        <!-- ============================= Row 0: Toolbar / custom title bar ============================= -->
        <Grid x:Name="ToolbarRow" Grid.Row="0" Height="44" Background="{DynamicResource ChromeBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- nav buttons -->
                <ColumnDefinition Width="*"/>    <!-- address bar -->
                <ColumnDefinition Width="Auto"/> <!-- library / menu -->
                <ColumnDefinition Width="Auto"/> <!-- min/max/close -->
            </Grid.ColumnDefinitions>

            <!-- Navigation buttons. Icons are hand-drawn vector Paths (Lucide/
                 Feather-style rounded outline strokes) sharing the NavIconPath
                 style above, not Unicode glyph characters — see NavIconButton's
                 doc comment in App.xaml for why. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,4,0" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource NavIconButton}" Click="BackButton_Click" ToolTip="Back">
                    <Path Style="{StaticResource NavIconPath}" Data="M15,6 L9,12 L15,18"/>
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource NavIconButton}" Click="ForwardButton_Click" ToolTip="Forward">
                    <Path Style="{StaticResource NavIconPath}" Data="M9,6 L15,12 L9,18"/>
                </Button>
                <Button x:Name="ReloadButton" Style="{StaticResource NavIconButton}" Click="ReloadButton_Click" ToolTip="Reload">
                    <Path Style="{StaticResource NavIconPath}"
                          Data="M12,4 A8,8 0 1 0 19.5,9 M20,4 L19.5,9 L15,8"/>
                </Button>
                <Button x:Name="HomeButton" Style="{StaticResource NavIconButton}" Click="HomeButton_Click" ToolTip="Home">
                    <Path Style="{StaticResource NavIconPath}"
                          Data="M4,11 L12,4 L20,11 M6,10 L6,20 L18,20 L18,10 M10,20 L10,14 L14,14 L14,20"/>
                </Button>
                <Button x:Name="NewTabButton" Style="{StaticResource NavIconButton}" Click="NewTabButton_Click" ToolTip="New Tab (Ctrl+T)">
                    <Path Style="{StaticResource NavIconPath}" Data="M12,5 L12,19 M5,12 L19,12"/>
                </Button>
            </StackPanel>

            <!-- Address bar: pill shape, lock + text + star inline. Background is a
                 semi-transparent themed overlay (not a hardcoded color) so a Custom
                 Themes gradient behind the toolbar shows through softly while typed
                 text stays legible in both Light and Dark mode — see
                 Themes/Light.xaml + Dark.xaml's AddressPillOverlayBrush. Margin is
                 a little wider on the left than before, now that the nav cluster
                 has 5 buttons instead of 4, so the bar doesn't feel like it starts
                 immediately at the last icon. -->
            <Border Grid.Column="1" Background="{DynamicResource AddressPillOverlayBrush}" CornerRadius="16" Height="32"
                    Margin="12,0,8,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LockIcon" Grid.Column="0" Text="🔒" FontSize="12"
                               Margin="12,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBox x:Name="AddressBarTextBox" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                             KeyDown="AddressBarTextBox_KeyDown"
                             GotFocus="AddressBarTextBox_GotFocus"/>

                    <Button x:Name="BookmarkStarButton" Grid.Column="2" Style="{StaticResource ChromeIconButton}"
                            Width="28" Height="28" Margin="0,0,2,0" Click="BookmarkStarButton_Click"
                            ToolTip="Bookmark this page" Content="☆"/>
                </Grid>
            </Border>

            <!-- Library + menu -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                <Button x:Name="LibraryButton" Style="{StaticResource ChromeIconButton}" Click="LibraryButton_Click"
                        ToolTip="Bookmarks, History &amp; Downloads" Content="📚"/>
                <Button x:Name="MenuButton" Style="{StaticResource ChromeIconButton}" Click="MenuButton_Click"
                        ToolTip="Menu" Content="☰"/>
            </StackPanel>

            <!-- Window controls -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,4,0">
                <Button Style="{StaticResource ChromeIconButton}" Click="MinimizeButton_Click" Content="—" ToolTip="Minimize"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeIconButton}" Click="MaximizeButton_Click" Content="▢" ToolTip="Maximize"/>
                <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click" Content="✕" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- ============================= Row 1: Tab strip (visible only when >= 2 tabs) ============================= -->
        <Border x:Name="TabStripBorder" Grid.Row="1" Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
            <ItemsControl x:Name="TabStripItems" Height="34">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,0"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <!-- ============================= Row 2: Bookmark bar (toggle via menu) ============================= -->
        <Border x:Name="BookmarkBarHost" Grid.Row="2" Height="30"
                Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <ItemsControl x:Name="BookmarkBarItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,0"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <!-- ============================= Row 3: Content host + slide-out Library panel ============================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Each BrowserTab's WebView2 (or NewTabPage) is added here in code-behind,
                 with only the active tab's element set to Visible. -->
            <Grid x:Name="TabContentHost" Grid.Column="0"/>

            <views:LibraryPanel x:Name="LibraryPanelControl" Grid.Column="1"
                                 Width="340" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>

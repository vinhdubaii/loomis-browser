<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- needed for FolderBrowserDialog in Settings -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LoomisBrowser</AssemblyName>
    <RootNamespace>LoomisBrowser</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Loomis Browser</Product>
    <Company>Lidora Studio</Company>
    <Copyright>Copyright © vinhdubaii</Copyright>
  </PropertyGroup>

  <!-- ApplicationIcon is only wired up once Assets\loomis.ico actually exists,
       so the project still builds while the Assets folder is empty. Drop a
       real .ico at src\Assets\loomis.ico and this activates automatically. -->
  <PropertyGroup Condition="Exists('Assets\loomis.ico')">
    <ApplicationIcon>Assets\loomis.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Assets folder is kept empty on purpose (user will add real icons later).
         Remove this ItemGroup exclusion once Assets/loomis.ico exists, or keep
         ApplicationIcon commented out until then to avoid a build error. -->
    <None Remove="Assets\**" />
  </ItemGroup>

</Project>
